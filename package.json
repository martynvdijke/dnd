{
  "name": "villum",
  "version": "2.53.6",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "npx vitest run",
    "test": "go test -tags sqlite_fts5 ./...",
    "test:e2e": "npx playwright test",
    "build:vite": "vite build",
    "build:dice": "esbuild dice/roller-entry.js --bundle --format=iife --global-name=__diceBundle --platform=browser --external:crypto --outfile=dice/bundle.js",
    "typecheck": "npx tsc --noEmit",
    "build:ts": "npm run build:vite && npm run typecheck",
    "watch:ts": "vite build --watch"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "bootstrap": "^5.3.0",
    "chart.js": "^4.4.7",
    "d3": "^7.9.0",
    "dompurify": "^3.4.14",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/dompurify": "^3.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.27.0",
    "happy-dom": "^20.10.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.9"
  }
}
