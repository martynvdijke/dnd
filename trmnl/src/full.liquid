<div class="layout layout--col layout--stretch gap--xsmall">
  {% if trmnl.plugin_settings.custom_fields_values.display_mode == 'roster' %}
  <div class="grid grid--cols-1">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Party Roster</span>
        <span class="value value--small">{{ IDX_2.size }} Characters</span>
        <span class="label">all characters</span>
      </div>
    </div>
  </div>
  <div class="grid grid--cols-2">
    {% for ch in IDX_2 %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">{{ ch.race }} {{ ch.class }}{% if ch.subclass %} · {{ ch.subclass }}{% endif %}</span>
        <span class="value value--medium">{{ ch.name }}</span>
        <span class="label">Level {{ ch.level }} · HP {{ ch.hp_current }}/{{ ch.hp_max }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
  {% elsif trmnl.plugin_settings.custom_fields_values.display_mode == 'campaign' %}
  <div class="grid grid--cols-1">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Campaign Progress</span>
        <span class="value value--small">{{ IDX_1.name }}</span>
        <span class="label">Level {{ IDX_1.level }}</span>
      </div>
    </div>
  </div>
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Sessions</span>
        <span class="value value--small">{{ IDX_1.session_count }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Total XP</span>
        <span class="value value--small">{{ IDX_1.total_xp_earned }}</span>
        <span class="label">xp</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Total Gold</span>
        <span class="value value--small">{{ IDX_1.total_gold_earned }}</span>
        <span class="label">gp</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Hit Points</span>
        <span class="value value--small">{{ IDX_1.hp_current }}/{{ IDX_1.hp_max }}</span>
      </div>
    </div>
  </div>
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Quests</span>
        <span class="value value--medium">{{ IDX_1.quests.active }} active</span>
        <span class="label">{{ IDX_1.quests.complete }} complete / {{ IDX_1.quests.failed }} failed</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Rests</span>
        <span class="value value--medium">{{ IDX_1.rests.short }} short / {{ IDX_1.rests.long }} long</span>
        <span class="label">{{ IDX_1.rests.total_healed }} HP healed</span>
      </div>
    </div>
  </div>
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="label">Top NPCs</span>
      <span class="value value--medium">{% for npc in IDX_1.top_npcs limit:3 %}{{ npc }}{% unless forloop.last %}, {% endunless %}{% endfor %}</span>
      <span class="label">{{ IDX_1.npc_interactions }} interactions</span>
    </div>
  </div>
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="label">Dice</span>
      <span class="value value--medium">{{ IDX_1.dice_rolls.total_rolls }} rolls</span>
      <span class="label">{{ IDX_1.dice_rolls.natural_20s }} nat 20s / {{ IDX_1.dice_rolls.natural_1s }} nat 1s</span>
    </div>
  </div>
  {% elsif trmnl.plugin_settings.custom_fields_values.display_mode == 'combat' %}
  {% if IDX_3.entries == blank or IDX_3.entries.size == 0 %}
  <div class="grid grid--cols-1">
    <div class="item">
      <div class="meta"></div>
      <div class="content text--center">
        <span class="label">Combat Tracker</span>
        <span class="value value--large">No active combat</span>
        <span class="label">the party is between fights</span>
      </div>
    </div>
  </div>
  {% else %}
  <div class="grid grid--cols-1">
    {% for e in IDX_3.entries %}
    <div class="item{% if e.is_active %} inverse{% endif %}">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Initiative {{ e.initiative_total }} · {{ e.type }}</span>
        <span class="value value--medium">{{ e.name }}</span>
        <span class="label">HP {{ e.hp_current }}/{{ e.hp_max }} · AC {{ e.ac }}{% if e.conditions.size > 0 %} · {% for c in e.conditions %}{{ c }}{% unless forloop.last %}, {% endunless %}{% endfor %}{% endif %}</span>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% else %}
  <div class="grid grid--cols-1">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">{{ IDX_0.race }} {{ IDX_0.class }}</span>
        <span class="value value--small">{{ IDX_0.name }}</span>
        <span class="label">Level {{ IDX_0.level }}</span>
      </div>
    </div>
  </div>
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Hit Points</span>
        <span class="value value--small">{{ IDX_0.hp_current }}/{{ IDX_0.hp_max }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Armor Class</span>
        <span class="value value--small">{{ IDX_0.ac }}</span>
      </div>
    </div>
  </div>
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">STR</span>
        <span class="value value--small">{{ IDX_0.str }}</span>
        <span class="label">{% if IDX_0.str_mod > 0 %}+{% endif %}{{ IDX_0.str_mod }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">DEX</span>
        <span class="value value--small">{{ IDX_0.dex }}</span>
        <span class="label">{% if IDX_0.dex_mod > 0 %}+{% endif %}{{ IDX_0.dex_mod }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">CON</span>
        <span class="value value--small">{{ IDX_0.con }}</span>
        <span class="label">{% if IDX_0.con_mod > 0 %}+{% endif %}{{ IDX_0.con_mod }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">INT</span>
        <span class="value value--small">{{ IDX_0.int }}</span>
        <span class="label">{% if IDX_0.int_mod > 0 %}+{% endif %}{{ IDX_0.int_mod }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">WIS</span>
        <span class="value value--small">{{ IDX_0.wis }}</span>
        <span class="label">{% if IDX_0.wis_mod > 0 %}+{% endif %}{{ IDX_0.wis_mod }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">CHA</span>
        <span class="value value--small">{{ IDX_0.cha }}</span>
        <span class="label">{% if IDX_0.cha_mod > 0 %}+{% endif %}{{ IDX_0.cha_mod }}</span>
      </div>
    </div>
  </div>
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Initiative</span>
        <span class="value value--small">{% if IDX_0.initiative > 0 %}+{% endif %}{{ IDX_0.initiative }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Experience</span>
        <span class="value value--small">{{ IDX_0.xp }}</span>
        <span class="label">xp</span>
      </div>
    </div>
  </div>
  {% endif %}
  <div class="title_bar">
    <img width="60" src="{{ trmnl.plugin_settings.custom_fields_values.url | default: 'https://dnd.example.com' }}/static/icon-192.png">
    <span class="title">Villum · D&D Stats</span>
  </div>
</div>
